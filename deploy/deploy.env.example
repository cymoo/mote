# Connection and layout for local-driven deploys.
# Copy to deploy.env (gitignored) and fill in your own values.
#
#   cp deploy.env.example deploy.env

SSH_HOST=example.com
SSH_USER=deploy
SSH_PORT=22

# Absolute path of the app root on the server.
REMOTE_DIR=/opt/mote

# Domain nginx serves. Used to render nginx.conf and to obtain the TLS cert.
DOMAIN=example.com

# How many past releases to keep on the server (for `make rollback`).
KEEP_RELEASES=5

# Local directory `make pull-uploads` mirrors the server's uploads/ into.
UPLOADS_MIRROR=$HOME/mote-backups/uploads
